# Server Environment Configuration
PORT=5001
NODE_ENV=development

# Session secret (must be at least 32 characters in production)
SESSION_SECRET=your-random-32-character-session-secret-here-replace-in-production

# Client origin for CORS
CORS_ORIGIN=http://localhost:5173

# SQLite database file path (relative or absolute)
DB_PATH=./storage/expense_tracker.db
