# Expense Tracker - Global Environment Configuration Example

# Backend Port and Environment
PORT=5001
NODE_ENV=development

# Session Encryption Secret (min 32 characters in production)
SESSION_SECRET=dev-insecure-secret-key-change-in-production-min-32-chars!

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# SQLite Database Location
DB_PATH=./server/storage/expense_tracker.db

# Frontend API Base URL (used by Vite client)
VITE_API_URL=http://localhost:5000/api
